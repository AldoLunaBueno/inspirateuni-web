#!/bin/sh
RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

current_branch="$(git branch --show-current)"

if [ "$current_branch" = "main" ]; then
    printf "${GREEN}Iniciando validación pre-push para Supabase...${NC}\n"
    
    cd backend || exit 1
    
    supabase start
    
    supabase test db
    TEST_RESULT=$?
    
    if [ "$TEST_RESULT" -ne 0 ]; then
        printf "${RED}Error: Las pruebas pgTAP fallaron. Push abortado.${NC}\n"
        exit 1
    fi
    
    printf "${GREEN}Pruebas de base de datos exitosas. Push permitido.${NC}\n"
fi